{
  "proxy": {
    "listen_host": "0.0.0.0",
    "listen_port": 8080,
    "backlog": 1024
  },
  "upstream": {
    "host": "127.0.0.1",
    "port": 9000,
    "connect_timeout": 3.0,
    "read_timeout": 10.0
  },
  "monitor": {
    "enabled": true,
    "url": "http://192.168.56.20:8000",
    "timeout": 2.0,
    "poll_blocklist_seconds": 5,
    "queue_max": 5000
  },
  "limits": {
    "window_seconds": 10,
    "max_requests_per_ip": 40,
    "max_requests_global": 500,
    "max_concurrent_per_ip": 12,
    "max_payload_bytes": 65536,
    "header_timeout": 5.0,
    "block_ttl_seconds": 300
  },
  "policy": {
    "block_on_malicious": true,
    "block_on_rate_limit": true,
    "block_on_conn_limit": true,
    "min_block_severity": "medium",
    "trust_forwarded_for": false,
    "malicious_blocklist_threshold": 3
  }
}